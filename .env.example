# 医保平台下发文件 API（演示可空，cmd/demo 默认走 fixture）
INS_PLATFORM_API_BASE_URL=
INS_PLATFORM_API_TOKEN=

# HIS 字典表数据库 DSN
#   MySQL:   user:pwd@tcp(host:3306)/his_db
#   PG:      postgres://user:pwd@host:5432/his_db
#   SQLite:  file:./state.db 或 :memory:
HIS_DB_DSN=

# 本地持久化 Plan / Issue / AuditEvent 的 SQLite 路径
STATE_DB_PATH=~/.insurance-rule-rollout/state.db

# 飞书 / 企微 webhook（会签通知双通道，二选一即可）
FEISHU_BOT_TOKEN=
WECOM_BOT_KEY=

# demo 模式开关（true = 用 fixture 跑；false = 连真实端点）
DEMO_FIXTURE_MODE=true
